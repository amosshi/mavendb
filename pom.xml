<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <!-- Parent of the modules: shared versions and project information only.
         Dependencies and plugins are declared by each module. -->
    <groupId>org.mavendb</groupId>
    <artifactId>mavendb</artifactId>
    <version>6.0</version>
    <packaging>pom</packaging>

    <name>mavendb</name>
    <description>Maven Central metadata: database loader and query API</description>
    <url>https://github.com/classviz/mavendb</url>

    <modules>
        <module>mavendb-loader</module>
        <module>mavendb-api</module>
    </modules>

    <organization>
        <name>Maven DB</name>
        <url>http://www.mavendb.org/</url>
    </organization>

    <properties>
        <maven.build.timestamp.format>yyyyMMdd.HHmmss</maven.build.timestamp.format>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <buildnumber-maven-plugin.version>3.4.0</buildnumber-maven-plugin.version><!-- https://mvnrepository.com/artifact/org.codehaus.mojo/buildnumber-maven-plugin -->
        <checkstyle.version>14.4.0</checkstyle.version><!-- https://mvnrepository.com/artifact/com.puppycrawl.tools/checkstyle -->
        <git-commit-id-maven-plugin.version>10.0.1</git-commit-id-maven-plugin.version><!-- https://mvnrepository.com/artifact/io.github.git-commit-id/git-commit-id-maven-plugin -->
        <maven-assembly-plugin.version>3.8.0</maven-assembly-plugin.version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-assembly-plugin -->
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-checkstyle-plugin -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-compiler-plugin -->
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-dependency-plugin -->
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-jar-plugin -->
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-javadoc-plugin -->
        <maven-jxr-plugin.version>3.6.0</maven-jxr-plugin.version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-jxr-plugin -->
        <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-pmd-plugin -->
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-resources-plugin -->
        <maven-scm-publish-plugin.version>3.3.0</maven-scm-publish-plugin.version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-scm-publish-plugin -->
        <maven-surefire-report-plugin.version>3.6.1</maven-surefire-report-plugin.version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-surefire-report-plugin -->
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version><!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-surefire-plugin -->
        <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version><!-- https://mvnrepository.com/artifact/com.github.spotbugs/spotbugs-maven-plugin -->

        <commons-cli.version>1.11.0</commons-cli.version><!-- https://mvnrepository.com/artifact/commons-cli/commons-cli -->
        <commons-lang3.version>3.22.0</commons-lang3.version><!-- https://mvnrepository.com/artifact/org.apache.commons/commons-lang3 -->
        <duckdb-jdbc.version>2.0.0.1</duckdb-jdbc.version><!-- https://mvnrepository.com/artifact/org.duckdb/duckdb_jdbc -->
        <indexer.version>7.1.6</indexer.version><!-- https://mvnrepository.com/artifact/org.apache.maven.indexer/indexer-reader -->
        <junit.version>6.1.3</junit.version><!-- https://mvnrepository.com/artifact/org.junit.jupiter/junit-jupiter -->
        <mariadb-java-client.version>4.0.0</mariadb-java-client.version><!-- https://mvnrepository.com/artifact/org.mariadb.jdbc/mariadb-java-client -->
        <mongodb-driver-sync.version>5.14.0</mongodb-driver-sync.version><!-- https://mvnrepository.com/artifact/org.mongodb/mongodb-driver-sync -->
        <mybatis.version>3.6.0</mybatis.version><!-- https://mvnrepository.com/artifact/org.mybatis/mybatis -->
        <mysql-connector-j.version>26.10.0</mysql-connector-j.version><!-- https://mvnrepository.com/artifact/com.mysql/mysql-connector-j -->
        <postgresql.version>42.7.14</postgresql.version><!-- https://mvnrepository.com/artifact/org.postgresql/postgresql -->
        <sqlite-jdbc.version>3.54.1.0</sqlite-jdbc.version><!-- https://mvnrepository.com/artifact/org.xerial/sqlite-jdbc -->
        <slf4j.version>2.0.20</slf4j.version><!-- https://mvnrepository.com/artifact/org.slf4j/slf4j-simple -->
        <spring-boot.version>4.1.2</spring-boot.version><!-- https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-dependencies -->
        <spotbugs.version>4.10.5</spotbugs.version><!-- https://mvnrepository.com/artifact/com.github.spotbugs/spotbugs -->
        <umldoclet.version>2.3.2</umldoclet.version><!-- https://mvnrepository.com/artifact/nl.talsmasoftware/umldoclet -->
    </properties>

    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/classviz/mavendb</connection>
        <developerConnection>scm:git:https://github.com/classviz/mavendb</developerConnection>
        <url>https://github.com/classviz/mavendb</url>
    </scm>
    <issueManagement>
        <system>github</system>
        <url>https://github.com/classviz/mavendb/issues</url>
    </issueManagement>
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub classviz Apache Maven Packages</name>
            <url>https://maven.pkg.github.com/classviz/mavendb</url>
        </repository>
        <site child.site.url.inherit.append.path="false">
            <id>github.com</id>
            <url>scm:git:https://github.com/classviz/mavendb.git</url>
        </site>
    </distributionManagement>

    <!-- Single place for every 3rd party version: modules declare dependencies without <version>.
         Explicit entries win over the imported BOMs below, so a jar shared by the modules
         (sqlite-jdbc, slf4j, junit, ...) resolves to the same version in all of them. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-annotations</artifactId>
                <version>${spotbugs.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mariadb.jdbc</groupId>
                <artifactId>mariadb-java-client</artifactId>
                <version>${mariadb-java-client.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql-connector-j.version}</version>
            </dependency>
            <dependency>
                <groupId>commons-cli</groupId>
                <artifactId>commons-cli</artifactId>
                <version>${commons-cli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.maven.indexer</groupId>
                <artifactId>indexer-reader</artifactId>
                <version>${indexer.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mongodb</groupId>
                <artifactId>mongodb-driver-sync</artifactId>
                <version>${mongodb-driver-sync.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis</artifactId>
                <version>${mybatis.version}</version>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>org.duckdb</groupId>
                <artifactId>duckdb_jdbc</artifactId>
                <version>${duckdb-jdbc.version}</version>
                <!-- One jar per platform, instead of the default jar that bundles 4 platforms (about 238 MB uncompressed).
                     Each platform jar has the same driver classes plus its own native library, named by platform
                     (libduckdb_java.so_linux_amd64, ...), so several can share the classpath: the driver loads the one
                     of the running platform. Platforms: linux_amd64, linux_arm64, linux_amd64_musl, linux_arm64_musl,
                     macos_arm64, macos_amd64, windows_amd64, windows_arm64 -->
                <classifier>linux_amd64</classifier>
            </dependency>
            <dependency>
                <groupId>org.duckdb</groupId>
                <artifactId>duckdb_jdbc</artifactId>
                <version>${duckdb-jdbc.version}</version>
                <classifier>macos_arm64</classifier>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- All MongoDB driver artifacts (bson, driver-core) on the version of mongodb-driver-sync,
                 instead of the older ones of the Spring Boot BOM -->
            <dependency>
                <groupId>org.mongodb</groupId>
                <artifactId>mongodb-driver-bom</artifactId>
                <version>${mongodb-driver-sync.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- All JUnit artifacts (jupiter, platform launcher) on one version -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Boot: versions of the mavendb-api stack, for anything not pinned above -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- JavaDoc with UML package and class diagrams (PlantUML), for every module -->
                <!-- https://github.com/talsma-ict/umldoclet -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                    <configuration>
                        <!-- Hide the per-file "Generating ..." notes -->
                        <quiet>true</quiet>
                        <doclet>nl.talsmasoftware.umldoclet.UMLDoclet</doclet>
                        <docletArtifact>
                            <groupId>nl.talsmasoftware</groupId>
                            <artifactId>umldoclet</artifactId>
                            <version>${umldoclet.version}</version>
                        </docletArtifact>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
