{
  "settings": {
    "index": {
      "number_of_shards": 8,
      "number_of_replicas": 0,
      "refresh_interval": "-1",
      "translog.durability": "async",
      "translog.flush_threshold_size": "2gb",
      "codec": "best_compression"
    }
  },
  "mappings": {
    "dynamic_templates": [
      { "other_strings": { "match_mapping_type": "string", "mapping": { "type": "keyword", "ignore_above": 1024 } } }
    ],
    "properties": {
      "groupId":          { "type": "keyword" },
      "artifactId":       { "type": "keyword" },
      "version":          { "type": "keyword" },
      "classifier":       { "type": "keyword" },
      "packaging":        { "type": "keyword" },
      "fileExtension":    { "type": "keyword" },
      "fileName":         { "type": "keyword" },
      "sha1":             { "type": "keyword" },
      "sha256":           { "type": "keyword" },
      "repositoryId":     { "type": "keyword" },
      "pluginPrefix":     { "type": "keyword" },
      "pluginGoals":      { "type": "keyword" },
      "classNames":       { "type": "keyword", "ignore_above": 1024 },
      "allGroups":        { "type": "keyword" },
      "rootGroups":       { "type": "keyword" },

      "majorVersion":     { "type": "integer" },
      "versionSeq":       { "type": "long" },
      "fileModified":     { "type": "date", "format": "epoch_millis||strict_date_optional_time" },
      "recordModified":   { "type": "date", "format": "epoch_millis||strict_date_optional_time" },
      "fileSize":         { "type": "long" },

      "hasSignature":     { "type": "boolean" },
      "hasSources":       { "type": "boolean" },
      "hasJavadoc":       { "type": "boolean" },

      "name":             { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } },
      "description":      { "type": "text" },

      "Bundle-SymbolicName":                 { "type": "keyword" },
      "Bundle-Version":                      { "type": "keyword" },
      "Bundle-Name":                         { "type": "text" },
      "Bundle-Description":                  { "type": "text" },
      "Bundle-DocURL":                       { "type": "keyword", "ignore_above": 1024 },
      "Bundle-License":                      { "type": "text" },
      "Bundle-RequiredExecutionEnvironment": { "type": "keyword", "ignore_above": 1024 },
      "Fragment-Host":                       { "type": "keyword", "ignore_above": 1024 },
      "Export-Package":                      { "type": "text" },
      "Import-Package":                      { "type": "text" },
      "Export-Service":                      { "type": "text" },
      "Require-Bundle":                      { "type": "text" },
      "Provide-Capability":                  { "type": "text" },
      "Require-Capability":                  { "type": "text" }
    }
  }
}
